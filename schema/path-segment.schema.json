          "$ref": "https://access-maps.local/schema/field-value.schema.json"
        },
        "min_width": {
          "$ref": "https://access-maps.local/schema/field-value.schema.json"
        },
        "stair_count": {
          "$ref": "https://access-maps.local/schema/field-value.schema.json"
