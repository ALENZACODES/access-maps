        "step_count",
        "handrail",
        "access",
        "length_m",
        "max_slope",
        "min_width",
        "stair_count",
        "from_ref",
        "to_ref",
        "geometry",
        "geometry_type",
        "crossing",
        "pathway_mode",
        "bidirectional",
        "oneway",
        "traversal_time_s",
        "signposted_as",
        "reversed_signposted_as",
        "ramp",
        "indoor"
      ],
      "properties": {
        "kind": {
          "$ref": "https://access-maps.local/schema/field-value.schema.json"
        },
        "footway": {
          "$ref": "https://access-maps.local/schema/field-value.schema.json"
