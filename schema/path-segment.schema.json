{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-maps.local/schema/path-segment.schema.json",
  "title": "PathSegment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tranche",
    "region",
    "fields"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tranche": {
      "const": "path"
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "footway",
        "foot",
        "surface",
        "smoothness",
        "incline",
        "width",
        "kerb",
        "tactile_paving",
        "lit",
        "wheelchair",
