{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-maps.invalid/schemas/condition.json",
  "title": "ConditionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "fact",
    "last_fetched",
    "last_checked",
    "expiry_hours"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "snowbank",
        "ice",
        "construction",
        "road_restriction",
        "curb_blocked",
        "other"
      ]
    },
    "point": { "$ref": "#/$defs/point" },
    "cell": { "type": "string", "minLength": 1 },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "enum": ["Point", "MultiPoint", "LineString", "MultiLineString", "Polygon", "MultiPolygon"]
        },
        "coordinates": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["value", "source_id", "licence", "retrieved_at", "tier"],
      "properties": {
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "boolean" },
            { "type": "number" }
          ]
        },
        "source_id": { "type": "string", "minLength": 1 },
        "licence": {
          "enum": ["ODbL", "OGL-Ontario", "OGL-Canada", "CC-BY", "CC0"]
        },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "tier": { "const": 1 },
        "source_key": { "type": "string" },
        "raw": {},
        "derived": {}
      },
      "additionalProperties": false
    },
    "last_fetched": { "type": "string", "format": "date-time" },
    "last_checked": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "expiry_hours": { "enum": [1, 3, 6, 12, 24, 48] }
  },
  "anyOf": [
    { "required": ["point"] },
    { "required": ["cell"] },
    { "required": ["geometry"] }
  ],
  "$defs": {
    "point": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    }
  }
}
