{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-maps.local/schema/journey-leg.schema.json",
  "title": "JourneyLeg",
  "type": "object",
  "required": ["id", "mode", "stepFree", "distanceKind", "surface", "gradient", "provenance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string" },
    "distanceKind": { "enum": ["route", "straight-line", "unknown"] },
    "surface": { "type": "string" },
    "gradient": { "type": "string" },
    "stepFree": {
      "type": "object",
      "required": ["status", "appVerified", "reasons", "evidence"],
      "properties": {
        "status": { "enum": ["step-free", "unknown", "not-step-free"] },
        "appVerified": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sourceId", "licence", "retrievedAt", "tier"],
      "properties": {
        "sourceId": { "type": "string" },
        "licence": { "type": "string" },
        "retrievedAt": { "type": "string" },
        "tier": { "enum": [0, 1, 2, 3, 4] }
      }
    }
  }
}
